# Files NOT uploaded to Cloud Build by `gcloud run deploy --source .`
.gcloudignore
.git
.gitignore
.venv/
__pycache__/
*.py[cod]
.env
.env.*
tests/
plans/
PROMPTS.md
CLAUDE.md
.vscode/
.idea/
# Rebuilt by Cloud Build from web/ (keeps the upload small)
web/node_modules/
web/.next/
web/out/
*.tsbuildinfo
